# ============================================================
#  Next.js
# ============================================================
.next/
out/
next-env.d.ts
*.tsbuildinfo

# ============================================================
#  Archivos publicados generados en tiempo de compilacion
#  (se copian desde data/ y assets/ con preparar_publico.mjs;
#   no se duplican en Git para no inflar el repositorio)
# ============================================================
public/datos/
public/modelos/
public/ifc/

# ============================================================
#  Dependencias y caches de herramientas
# ============================================================
node_modules/
.npm-cache/
.npm/
__pycache__/
*.pyc
.venv/
venv/
env/
.cache/
.pytest_cache/

# ============================================================
#  Salidas de build
# ============================================================
dist/
build/
.vite/
*.local

# ============================================================
#  Backups automáticos de Revit y AutoCAD
#  (las versiones numeradas son redundantes: conservamos solo
#   TIERRABOMBA.rvt y TOPOGRAFIA1.rvt canónicos)
# ============================================================
*.[0-9][0-9][0-9][0-9].rvt
*.rws
*.slog
*.dwl
*.dwl2
*.bak
*.sv$
*.pcp
*.log
plot.log
$RECYCLE.BIN/

# ============================================================
#  Basura del sistema operativo
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# ============================================================
#  Secretos — nunca al repositorio público
# ============================================================
.env
.env.*
!.env.example
CLAVES.txt
*.pem
*.key
credentials.json
